{
  "name": "demiurge",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "wasm:build": "pnpm --filter @demiurge/wasm-sim run build",
    "wasm:build:dev": "pnpm --filter @demiurge/wasm-sim run build:dev",
    "wasm:watch": "pnpm --filter @demiurge/wasm-sim run build:watch",
    "dev": "pnpm run wasm:build:dev && concurrently -k -n wasm,web \"pnpm run wasm:watch\" \"pnpm --filter @demiurge/web run dev\"",
    "build": "pnpm run wasm:build && pnpm -r --filter @demiurge/shared --filter @demiurge/web run build",
    "test": "pnpm run test:rust && pnpm run wasm:build && pnpm run test:ts && pnpm run test:e2e:no-build",
    "test:rust": "cargo test --workspace",
    "test:ts": "pnpm --filter @demiurge/shared --filter @demiurge/web run test",
    "test:e2e": "pnpm run wasm:build && pnpm run test:e2e:no-build",
    "test:e2e:no-build": "playwright test",
    "format": "prettier --check .",
    "gen:golden": "tsx scripts/gen-prng-golden.ts",
    "gen:fixtures": "tsx scripts/gen-worldspec-fixture.ts",
    "gen:m2:fixtures": "tsx scripts/gen-m2-fixtures.ts",
    "gen:m3:fixtures": "tsx scripts/gen-m3-fixtures.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "chokidar-cli": "^3.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "tsx": "^4.20.5"
  }
}
