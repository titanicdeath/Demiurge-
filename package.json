{
  "name": "demiurge",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "concurrently -k -n wasm,web \"pnpm --filter @demiurge/wasm-sim build:watch\" \"pnpm --filter @demiurge/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm run test:rust && pnpm run test:ts && pnpm run test:e2e",
    "test:ts": "pnpm -r --filter './packages/**' test",
    "test:rust": "cargo test --workspace",
    "test:e2e": "playwright test",
    "format": "prettier --check .",
    "gen:golden": "tsx scripts/gen-prng-golden.ts",
    "gen:fixtures": "tsx scripts/gen-worldspec-fixture.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "chokidar-cli": "^3.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "tsx": "^4.20.5"
  }
}
